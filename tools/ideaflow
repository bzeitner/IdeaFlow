#!/usr/bin/env python3
"""Remote client for a deployed IdeaFlow.

Lets an agent on ANY machine drive the read/report loop over the HTTP API — no
repo checkout or database access needed. Pure standard library, so there's
nothing to pip install; you just need python3.

Configure via environment:
  IDEAFLOW_API_BASE    default https://ideaflow.bitesoftheweek.com
  IDEAFLOW_API_TOKEN   the shared bearer token (required)

Commands:
  ideaflow list-ideas [--status current|tracking|archived]
  ideaflow dump-idea <id>
  ideaflow weekly-summaries
  ideaflow log-weekly-summary --period-start YYYY-MM-DD --period-end YYYY-MM-DD
                              --summary-file F [--title T] [--model M]
  ideaflow remove-resource <idea-id> <resource-id>
  ideaflow reconcile-pr <idea-id> --url URL --state CLOSED|MERGED
  ideaflow submit-persona-review <idea-id> --review-file FILE
  ideaflow relationship-council-queue [--limit N]
  ideaflow submit-relationship-council-review <suggestion-id> --review-file FILE
  ideaflow log-effort <id> --topic T --model M [--context-file F | --context S]
                      [--focus F] [--effort N] [--quality N] [--tokens N]
                      [--repo-url U --repo-label L] [--stage S] [--status S]
  ideaflow upload-artifact <id> --file F --title T
                      [--kind report|list|summary] [--research-entry ID]
  ideaflow add-feed --url URL [--idea <id>] [--title T]
  ideaflow feed-items [--unsummarized | --unassessed --idea <id>] [--feed <id>]
                      [--per-feed N] [--limit N] [--offset N] [--content]
  ideaflow summarize-item <id> --idea <idea-id>
                      [--summary-file F | --summary S] [--model M]
                      [--usefulness N] [--relevance-note TEXT]

Every command prints the JSON the server returned.
"""

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid

DEFAULT_BASE = "https://ideaflow.bitesoftheweek.com"


def _request(method, path, *, params=None, body=None, execution=False):
    base = os.environ.get("IDEAFLOW_API_BASE", DEFAULT_BASE).rstrip("/")
    token_name = "IDEAFLOW_EXECUTION_API_TOKEN" if execution else "IDEAFLOW_API_TOKEN"
    token = os.environ.get(token_name, "").strip()
    if not token:
        sys.exit(f"error: {token_name} is not set.")

    prefix = "/api/executions" if execution else "/api"
    url = f"{base}{prefix}{path}"
    if params:
        query = urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
        if query:
            url = f"{url}?{query}"

    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {token}")
    # Identify ourselves and accept JSON — a default urllib User-Agent trips
    # Cloudflare's Browser Integrity Check (HTTP 403, error 1010).
    req.add_header("User-Agent", "IdeaFlow-Agent/1.0 (+https://ideaflow.bitesoftheweek.com)")
    req.add_header("Accept", "application/json")
    if data is not None:
        req.add_header("Content-Type", "application/json")

    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        sys.exit(f"error: HTTP {exc.code} from {url}\n{detail}")
    except urllib.error.URLError as exc:
        sys.exit(f"error: could not reach {url}: {exc.reason}")


def _multipart_request(path, fields, file_path):
    boundary = f"----IdeaFlow{uuid.uuid4().hex}"
    chunks = []
    for name, value in fields.items():
        if value is None:
            continue
        chunks.append(
            f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n{value}\r\n".encode()
        )
    filename = os.path.basename(file_path)
    with open(file_path, "rb") as fh:
        content = fh.read()
    chunks.append(
        f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"{filename}\"\r\nContent-Type: application/octet-stream\r\n\r\n".encode()
        + content
        + b"\r\n"
    )
    chunks.append(f"--{boundary}--\r\n".encode())
    base = os.environ.get("IDEAFLOW_API_BASE", DEFAULT_BASE).rstrip("/")
    token = os.environ.get("IDEAFLOW_API_TOKEN", "").strip()
    if not token:
        sys.exit("error: IDEAFLOW_API_TOKEN is not set.")
    endpoint = f"{base}/api{path}"
    req = urllib.request.Request(endpoint, data=b"".join(chunks), method="POST")
    req.add_header("Authorization", f"Bearer {token}")
    req.add_header("User-Agent", "IdeaFlow-Agent/1.0 (+https://ideaflow.bitesoftheweek.com)")
    req.add_header("Accept", "application/json")
    req.add_header("Content-Type", f"multipart/form-data; boundary={boundary}")
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read() or b"{}")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        sys.exit(f"error: HTTP {exc.code} from {endpoint}\n{detail}")
    except urllib.error.URLError as exc:
        sys.exit(f"error: could not reach {endpoint}: {exc.reason}")


def _read_text(inline, path):
    if path:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    return inline or ""


def cmd_config(a):
    return _request("GET", "/config/")


def cmd_prompt(a):
    return _request("GET", f"/prompts/{a.key}/")


def cmd_list_ideas(a):
    return _request("GET", "/ideas/", params={"status": a.status})


def cmd_dump_idea(a):
    return _request("GET", f"/ideas/{a.id}/")


def cmd_weekly_summaries(a):
    return _request("GET", "/weekly-summaries/")


def cmd_log_weekly_summary(a):
    metrics = {}
    if a.metrics_file:
        with open(a.metrics_file, encoding="utf-8") as fh:
            metrics = json.load(fh)
    return _request(
        "POST",
        "/weekly-summaries/",
        body={
            "period_start": a.period_start,
            "period_end": a.period_end,
            "title": a.title,
            "content": _read_text(a.summary, a.summary_file),
            "model": a.model,
            "execution_provider": a.provider,
            "tokens_used": a.tokens,
            "metrics": metrics,
            "execution_run_id": os.environ.get("IDEAFLOW_RUN_ID") or None,
        },
    )


def cmd_remove_resource(a):
    return _request("DELETE", f"/ideas/{a.idea_id}/resources/{a.resource_id}/")


def cmd_reconcile_pr(a):
    return _request(
        "POST",
        f"/ideas/{a.idea_id}/reconcile-pr/",
        body={"url": a.url, "state": a.state},
    )


def cmd_graph(a):
    return _request("GET", "/graph/", params={"archived": "1" if a.archived else None})


def cmd_graph_context(a):
    return _request(
        "GET",
        f"/ideas/{a.id}/graph-context/",
        params={"depth": a.depth, "max_nodes": a.max_nodes, "task": a.task},
    )


def cmd_graph_search(a):
    return _request("GET", "/graph/search/", params={"q": a.query})


def cmd_log_effort(a):
    body = {
        "topic": a.topic,
        "model": a.model,
        "execution_provider": a.provider,
        "execution_model": a.execution_model,
        "context": _read_text(a.context, a.context_file),
        "focus": a.focus,
        "effort": a.effort,
        "quality": a.quality,
        "tokens_used": a.tokens,
        "stage": a.stage,
        "status": a.status,
        "next_action": a.next_action,
        "queued_next_actions": a.queue_next_action,
        "exec_summary": a.exec_summary,
        "open_questions": a.open_question,
        "execution_run_id": os.environ.get("IDEAFLOW_RUN_ID") or None,
    }
    if a.repo_url:
        body["resource"] = {"url": a.repo_url, "label": a.repo_label or ""}
    return _request("POST", f"/ideas/{a.id}/effort/", body=body)


def cmd_upload_artifact(a):
    endpoint = f"/ideas/{a.id}/artifacts/"
    if a.artifact_id:
        endpoint = f"/ideas/{a.id}/artifacts/{a.artifact_id}/"
    return _multipart_request(
        endpoint,
        {
            "title": a.title,
            "description": a.description or "",
            "kind": a.kind,
            "research_entry_id": a.research_entry,
            "execution_run_id": os.environ.get("IDEAFLOW_RUN_ID") or None,
        },
        a.file,
    )


def cmd_log_repeat_results(a):
    with open(a.results_file, encoding="utf-8") as fh:
        results = json.load(fh)
    return _request(
        "POST", f"/ideas/{a.id}/repeat-results/",
        body={
            "results": results,
            "execution_run_id": os.environ.get("IDEAFLOW_RUN_ID") or None,
        },
    )


def cmd_create_podcast_episode(a):
    with open(a.script_file, encoding="utf-8") as fh:
        script = json.load(fh)
    body = {"title": a.title, "script": script}
    body["execution_run_id"] = os.environ.get("IDEAFLOW_RUN_ID") or None
    if a.description:
        body["description"] = a.description
    if a.show_notes:
        body["show_notes"] = a.show_notes
    if a.research_entry_id:
        body["research_entry_id"] = a.research_entry_id
    return _request("POST", f"/ideas/{a.id}/podcast-episode/", body=body)


def cmd_submit_persona_review(a):
    with open(a.review_file, encoding="utf-8") as fh:
        body = json.load(fh)
    body["execution_run_id"] = os.environ.get("IDEAFLOW_RUN_ID") or None
    return _request("POST", f"/ideas/{a.id}/persona-reviews/", body=body)


def cmd_relationship_council_queue(a):
    return _request("GET", "/relationship-council-reviews/", params={"limit": a.limit})


def cmd_submit_relationship_council_review(a):
    with open(a.review_file, encoding="utf-8") as fh:
        body = json.load(fh)
    if os.environ.get("IDEAFLOW_RUN_ID"):
        body["execution_run_id"] = os.environ["IDEAFLOW_RUN_ID"]
    return _request(
        "POST",
        f"/relationship-council-reviews/{a.suggestion_id}/",
        body=body,
    )


def cmd_feed_items(a):
    params = {
        "feed": a.feed,
        "idea": a.idea,
        "per_feed": a.per_feed,
        "limit": a.limit,
        "offset": a.offset,
    }
    if a.unsummarized:
        params["unsummarized"] = "1"
    if a.unassessed:
        params["unassessed"] = "1"
    if a.content:
        params["content"] = "1"
    return _request("GET", "/feed-items/", params=params)


def cmd_add_child(a):
    body = {"title": a.title, "summary": a.summary or ""}
    if a.category:
        body["category"] = a.category
    return _request("POST", f"/ideas/{a.id}/children/", body=body)


def cmd_suggest_children(a):
    return _request(
        "POST", f"/ideas/{a.id}/suggest-children/", body={"suggestions": a.suggestion}
    )


def cmd_add_feed(a):
    body = {"url": a.url, "title": a.title or ""}
    if a.idea:
        body["idea_id"] = a.idea
    if a.rating is not None:
        body["rating"] = a.rating
    return _request("POST", "/feeds/", body=body)


def cmd_summarize_item(a):
    body = {
        "summary": _read_text(a.summary, a.summary_file),
        "model": a.model,
        "usefulness": a.usefulness,
        "idea_id": a.idea,
        "relevance_note": a.relevance_note,
        "execution_run_id": os.environ.get("IDEAFLOW_RUN_ID") or None,
    }
    return _request("POST", f"/feed-items/{a.id}/summarize/", body=body)


def _sha256_file(path):
    import hashlib

    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def cmd_trace_start(a):
    return _request(
        "POST", "/v1/traces/", execution=True,
        body={
            "workflow": a.workflow,
            "workflow_version": a.workflow_version,
            "subject": {"type": "idea", "id": a.idea} if a.idea else None,
            "trigger": a.trigger,
            "correlation_key": a.correlation_key,
            "idempotency_key": a.idempotency_key,
        },
    )


def cmd_run_start(a):
    body = {
        "provider": a.provider,
        "model": a.model,
        "purpose": a.purpose,
        "prompt_keys": a.prompt_key,
        "rendered_input_hash": _sha256_file(a.input_file),
        "idempotency_key": a.idempotency_key,
    }
    if os.environ.get("IDEAFLOW_EXECUTION_CAPTURE_PAYLOADS", "").lower() in {"1", "true", "yes"}:
        body["rendered_input"] = _read_text("", a.input_file)
    return _request(
        "POST", f"/v1/traces/{a.trace_id}/runs/", execution=True, body=body
    )


def cmd_run_complete(a):
    body = {
        "output_hash": _sha256_file(a.output_file),
        "finish_reason": a.finish_reason,
        "measurement_status": a.measurement_status,
        "measurement_unavailable_reasons": a.measurement_unavailable_reason,
        "usage": {
            "input_tokens": a.input_tokens,
            "output_tokens": a.output_tokens,
            "cached_tokens": a.cached_tokens,
            "reasoning_tokens": a.reasoning_tokens,
            "total_tokens": a.total_tokens,
        },
        "provider_request_id": a.provider_request_id,
        "cost_micros": a.cost_micros,
        "cost_source": a.cost_source,
    }
    if os.environ.get("IDEAFLOW_EXECUTION_CAPTURE_PAYLOADS", "").lower() in {"1", "true", "yes"}:
        body["output"] = _read_text("", a.output_file)
    return _request(
        "POST", f"/v1/runs/{a.run_id}/complete/", execution=True, body=body
    )


def cmd_run_fail(a):
    return _request(
        "POST", f"/v1/runs/{a.run_id}/fail/", execution=True,
        body={
            "error_class": a.error_class,
            "error_code": a.error_code,
            "error_detail": a.error_detail,
            "measurement_status": "unavailable",
            "measurement_unavailable_reasons": a.measurement_unavailable_reason,
        },
    )


def cmd_trace_complete(a):
    return _request(
        "POST", f"/v1/traces/{a.trace_id}/complete/", execution=True, body={}
    )


def cmd_trace_fail(a):
    return _request(
        "POST", f"/v1/traces/{a.trace_id}/fail/", execution=True,
        body={"reason": a.reason},
    )


def cmd_tool_start(a):
    return _request(
        "POST", f"/v1/runs/{a.run_id}/tools/", execution=True,
        body={
            "tool_name": a.tool_name,
            "tool_version": a.tool_version,
            "mutating": a.mutating,
            "request_hash": a.request_hash,
            "idempotency_key": a.idempotency_key,
        },
    )


def cmd_tool_complete(a):
    return _request(
        "POST", f"/v1/tools/{a.tool_id}/complete/", execution=True,
        body={"response_hash": a.response_hash},
    )


def cmd_tool_fail(a):
    return _request(
        "POST", f"/v1/tools/{a.tool_id}/fail/", execution=True,
        body={"error_class": a.error_class, "error_detail": a.error_detail},
    )


def build_parser():
    p = argparse.ArgumentParser(prog="ideaflow", description="Remote IdeaFlow client.")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("config", help="Task->model routing + model tiers.")
    s.set_defaults(func=cmd_config)

    s = sub.add_parser("prompt", help="Fetch one active approved prompt revision.")
    s.add_argument("key")
    s.set_defaults(func=cmd_prompt)

    s = sub.add_parser("list-ideas")
    s.add_argument("--status")
    s.set_defaults(func=cmd_list_ideas)

    s = sub.add_parser("dump-idea")
    s.add_argument("id", type=int)
    s.set_defaults(func=cmd_dump_idea)

    s = sub.add_parser("weekly-summaries", help="List generated weekly portfolio summaries.")
    s.set_defaults(func=cmd_weekly_summaries)

    s = sub.add_parser("log-weekly-summary", help="Create or replace one weekly portfolio summary.")
    s.add_argument("--period-start", required=True)
    s.add_argument("--period-end", required=True)
    s.add_argument("--title", default="")
    s.add_argument("--summary", default="")
    s.add_argument("--summary-file")
    s.add_argument("--model", default="")
    s.add_argument("--provider", default="")
    s.add_argument("--tokens", type=int)
    s.add_argument("--metrics-file", help="JSON file containing structured weekly metrics.")
    s.set_defaults(func=cmd_log_weekly_summary)

    s = sub.add_parser(
        "remove-resource", help="Remove a stale resource from an idea."
    )
    s.add_argument("idea_id", type=int)
    s.add_argument("resource_id", type=int)
    s.set_defaults(func=cmd_remove_resource)

    s = sub.add_parser("reconcile-pr", help="Apply a verified closed or merged PR state.")
    s.add_argument("idea_id", type=int)
    s.add_argument("--url", required=True)
    s.add_argument("--state", required=True, choices=("CLOSED", "MERGED"))
    s.set_defaults(func=cmd_reconcile_pr)

    s = sub.add_parser("graph", help="Read the projected knowledge graph.")
    s.add_argument("--archived", action="store_true")
    s.set_defaults(func=cmd_graph)

    s = sub.add_parser("graph-context", help="Read bounded graph context for an idea.")
    s.add_argument("id", type=int)
    s.add_argument("--depth", type=int, default=1)
    s.add_argument("--max-nodes", type=int, default=30, dest="max_nodes")
    s.add_argument(
        "--task",
        default=None,
        help="Biases which relation types are prioritized within the token "
        "budget (e.g. research, review, execute, critique, persona, repeat). "
        "Omit to use the server default.",
    )
    s.set_defaults(func=cmd_graph_context)

    s = sub.add_parser("graph-search", help="Search ideas exposed by the graph.")
    s.add_argument("query")
    s.set_defaults(func=cmd_graph_search)

    s = sub.add_parser("log-effort")
    s.add_argument("id", type=int)
    s.add_argument("--topic", required=True)
    s.add_argument("--model", default="other")
    s.add_argument("--provider", default="")
    s.add_argument("--execution-model", default="")
    s.add_argument("--context", default="")
    s.add_argument("--context-file")
    s.add_argument("--focus", default="")
    s.add_argument("--effort", type=int, default=3)
    s.add_argument("--quality", type=int, default=3)
    s.add_argument("--tokens", type=int)
    s.add_argument("--repo-url")
    s.add_argument("--repo-label", default="")
    s.add_argument("--stage")
    s.add_argument("--status")
    s.add_argument("--next-action", dest="next_action")
    s.add_argument(
        "--queue-next-action",
        action="append",
        default=[],
        help="Queue another action after the active one; repeatable.",
    )
    s.add_argument(
        "--exec-summary",
        dest="exec_summary",
        help="Latest effort outcome and recommended next steps for humans.",
    )
    s.add_argument(
        "--open-question",
        action="append",
        default=[],
        help="Question requiring human input before a later run; repeatable.",
    )
    s.set_defaults(func=cmd_log_effort)

    s = sub.add_parser("upload-artifact", help="Upload a durable report or list for an idea.")
    s.add_argument("id", type=int)
    s.add_argument("--file", required=True)
    s.add_argument("--title", required=True)
    s.add_argument("--description")
    s.add_argument("--kind", choices=["report", "list", "summary"], default="report")
    s.add_argument("--research-entry", type=int)
    s.add_argument("--artifact-id", type=int)
    s.set_defaults(func=cmd_upload_artifact)

    s = sub.add_parser("log-repeat-results", help="Record one completed repeat run.")
    s.add_argument("id", type=int)
    s.add_argument("--results-file", required=True, help="JSON array of result objects.")
    s.set_defaults(func=cmd_log_repeat_results)

    s = sub.add_parser(
        "create-podcast-episode",
        help="Create a podcast episode + render job from a structured script, "
        "and advance the idea's repeat clock. Use instead of log-repeat-results "
        "for a podcast idea's repeat run.",
    )
    s.add_argument("id", type=int)
    s.add_argument("--title", required=True)
    s.add_argument("--script-file", required=True, help="JSON script document.")
    s.add_argument("--description", default=None)
    s.add_argument("--show-notes", default=None)
    s.add_argument("--research-entry-id", type=int, default=None)
    s.set_defaults(func=cmd_create_podcast_episode)

    s = sub.add_parser("submit-persona-review", help="Submit a persona council proposal and votes.")
    s.add_argument("id", type=int)
    s.add_argument("--review-file", required=True, help="JSON object containing proposal and votes.")
    s.set_defaults(func=cmd_submit_persona_review)

    s = sub.add_parser("relationship-council-queue", help="List unreviewed pending relationship suggestions.")
    s.add_argument("--limit", type=int, default=10)
    s.set_defaults(func=cmd_relationship_council_queue)

    s = sub.add_parser("submit-relationship-council-review", help="Submit three attributed relationship votes.")
    s.add_argument("suggestion_id", type=int)
    s.add_argument("--review-file", required=True)
    s.set_defaults(func=cmd_submit_relationship_council_review)

    s = sub.add_parser("add-child", help="Propose a child idea (top-level ideas only, max 5).")
    s.add_argument("id", type=int)
    s.add_argument("--title", required=True)
    s.add_argument("--summary", default="")
    s.add_argument("--category", help="Category slug/name (defaults to the parent's).")
    s.set_defaults(func=cmd_add_child)

    s = sub.add_parser("suggest-children", help="Suggest child ideas for a human to create.")
    s.add_argument("id", type=int)
    s.add_argument("--suggestion", action="append", default=[], help="Repeatable.")
    s.set_defaults(func=cmd_suggest_children)

    s = sub.add_parser("add-feed")
    s.add_argument("--url", required=True)
    s.add_argument("--idea", type=int)
    s.add_argument("--title", default="")
    s.add_argument("--rating", type=int, help="Relevance to the idea (1-5).")
    s.set_defaults(func=cmd_add_feed)

    s = sub.add_parser("feed-items")
    s.add_argument("--unsummarized", action="store_true")
    s.add_argument(
        "--unassessed",
        action="store_true",
        help="Only items without an assessment for --idea.",
    )
    s.add_argument("--feed", type=int)
    s.add_argument("--idea", type=int)
    s.add_argument("--per-feed", type=int, dest="per_feed", help="Max items per feed.")
    s.add_argument("--limit", type=int, help="Max items returned.")
    s.add_argument("--offset", type=int, help="Skip this many items first.")
    s.add_argument(
        "--content",
        action="store_true",
        help="Include the stored entry body, so there's no page to re-fetch.",
    )
    s.set_defaults(func=cmd_feed_items)

    s = sub.add_parser("summarize-item")
    s.add_argument("id", type=int)
    s.add_argument("--summary", default="")
    s.add_argument("--summary-file")
    s.add_argument("--model", default="other")
    s.add_argument("--usefulness", type=int)
    s.add_argument("--idea", type=int, help="Idea this usefulness score applies to.")
    s.add_argument("--relevance-note", default="")
    s.set_defaults(func=cmd_summarize_item)

    s = sub.add_parser("trace-start", help="Create an idempotent execution trace.")
    s.add_argument("--workflow", required=True)
    s.add_argument("--workflow-version", type=int)
    s.add_argument("--idea", type=int)
    s.add_argument("--trigger", default="machine")
    s.add_argument("--correlation-key", default="")
    s.add_argument("--idempotency-key", default="")
    s.set_defaults(func=cmd_trace_start)

    s = sub.add_parser("run-start", help="Start one provider attempt under a trace.")
    s.add_argument("--trace-id", required=True)
    s.add_argument("--provider", required=True)
    s.add_argument("--model", required=True)
    s.add_argument("--purpose", default="generation", choices=(
        "generation", "classification", "extraction", "evaluation", "embedding"
    ))
    s.add_argument("--prompt-key", action="append", default=[])
    s.add_argument("--input-file", required=True)
    s.add_argument("--idempotency-key", default="")
    s.set_defaults(func=cmd_run_start)

    s = sub.add_parser("run-complete", help="Complete one provider attempt.")
    s.add_argument("--run-id", required=True)
    s.add_argument("--output-file", required=True)
    s.add_argument("--finish-reason", default="stop")
    s.add_argument("--measurement-status", choices=("complete", "partial"), default="partial")
    s.add_argument("--measurement-unavailable-reason", action="append", default=[])
    s.add_argument("--input-tokens", type=int)
    s.add_argument("--output-tokens", type=int)
    s.add_argument("--cached-tokens", type=int)
    s.add_argument("--reasoning-tokens", type=int)
    s.add_argument("--total-tokens", type=int)
    s.add_argument("--provider-request-id", default="")
    s.add_argument("--cost-micros", type=int)
    s.add_argument("--cost-source", default="")
    s.set_defaults(func=cmd_run_complete)

    s = sub.add_parser("run-fail", help="Fail one provider attempt.")
    s.add_argument("--run-id", required=True)
    s.add_argument("--error-class", required=True)
    s.add_argument("--error-code", default="")
    s.add_argument("--error-detail", default="")
    s.add_argument("--measurement-unavailable-reason", action="append", default=[])
    s.set_defaults(func=cmd_run_fail)

    s = sub.add_parser("trace-complete", help="Mark a trace successful.")
    s.add_argument("--trace-id", required=True)
    s.set_defaults(func=cmd_trace_complete)

    s = sub.add_parser("trace-fail", help="Mark a trace failed.")
    s.add_argument("--trace-id", required=True)
    s.add_argument("--reason", default="")
    s.set_defaults(func=cmd_trace_fail)

    s = sub.add_parser("tool-start", help="Start a tool invocation under a run.")
    s.add_argument("--run-id", required=True)
    s.add_argument("--tool-name", required=True)
    s.add_argument("--tool-version", default="")
    s.add_argument("--mutating", action="store_true")
    s.add_argument("--request-hash", default="")
    s.add_argument("--idempotency-key", default="")
    s.set_defaults(func=cmd_tool_start)

    s = sub.add_parser("tool-complete", help="Complete a tool invocation.")
    s.add_argument("--tool-id", required=True)
    s.add_argument("--response-hash", default="")
    s.set_defaults(func=cmd_tool_complete)

    s = sub.add_parser("tool-fail", help="Fail a tool invocation.")
    s.add_argument("--tool-id", required=True)
    s.add_argument("--error-class", required=True)
    s.add_argument("--error-detail", default="")
    s.set_defaults(func=cmd_tool_fail)

    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.cmd == "feed-items" and args.unassessed and not args.idea:
        parser.error("feed-items --unassessed requires --idea")
    if args.cmd == "summarize-item" and args.usefulness is not None and not args.idea:
        parser.error("summarize-item --usefulness requires --idea")
    print(json.dumps(args.func(args), indent=2))


if __name__ == "__main__":
    main()
