# Copy to .env and fill in. .env is gitignored and must never be committed.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Never true in production.
DJANGO_DEBUG=false

# Comma-separated. Add your real hostname(s) when deploying.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth client, from Google Cloud Console > APIs & Services > Credentials.
# See README.md "Google sign-in setup" for the exact steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional. Unset (the default) uses a local sqlite3 file, same as always.
# Set this to point at Postgres instead — see README.md "Using Postgres".
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Optional. Shared bearer token for the /api/ endpoints an external agent uses
# to read ideas and report effort. Empty (the default) disables the API.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
IDEAFLOW_API_TOKEN=
