# Copy to .env and fill in. .env is gitignored and must never be committed.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Never true in production.
DJANGO_DEBUG=false

# Comma-separated. Add your real hostname(s) when deploying.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth client, from Google Cloud Console > APIs & Services > Credentials.
# See README.md "Google sign-in setup" for the exact steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional. Unset (the default) uses a local sqlite3 file, same as always.
# Set this to point at Postgres instead — see README.md "Using Postgres".
#   postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Optional. Shared bearer token for the /api/ endpoints an external agent uses
# to read ideas and report effort. Empty (the default) disables the API.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
IDEAFLOW_API_TOKEN=

# Measurement-first rollout. Phase 0 declares these independent switches but
# leaves all execution behavior unchanged. Keep disabled until its owning phase
# has been deployed and verified.
IDEAFLOW_EXECUTION_INSTRUMENTATION=false
IDEAFLOW_EXECUTION_GATEWAY=false
IDEAFLOW_EXECUTION_PROJECTIONS=false
IDEAFLOW_EXECUTION_FEEDBACK=false
IDEAFLOW_EXECUTION_EXPERIMENTS=false
# Raw prompt/response capture is sensitive and disabled by default.
IDEAFLOW_EXECUTION_CAPTURE_PAYLOADS=false
IDEAFLOW_EXECUTION_PAYLOAD_RETENTION_DAYS=30
# Protected local storage, never served by nginx/WhiteNoise. Leave empty to use
# <project>/private_execution_payloads.
IDEAFLOW_EXECUTION_PAYLOAD_ROOT=
IDEAFLOW_EXECUTION_PAYLOAD_MAX_BYTES=10485760
IDEAFLOW_EXECUTION_API_MAX_BYTES=1048576
# Scoped execution API credentials are created with:
#   .venv/bin/python manage.py create_execution_principal NAME
# Put the one-time token on the worker as IDEAFLOW_EXECUTION_API_TOKEN; it does
# not belong in the server .env.

# Optional isolated, read-only Gephi Lite explorer. Use HTTPS in production.
IDEAFLOW_GRAPH_LAB_ENABLED=false
IDEAFLOW_GRAPH_LAB_ORIGIN=https://graph-lab.bitesoftheweek.com
IDEAFLOW_GRAPH_CAPABILITY_TTL_SECONDS=600
IDEAFLOW_GRAPH_CAPABILITY_MAX_REQUESTS=10
IDEAFLOW_GRAPH_EXPORT_MAX_NODES=2000
IDEAFLOW_GRAPH_EXPORT_MAX_EDGES=10000
IDEAFLOW_GRAPH_EXPORT_MAX_BYTES=20971520
IDEAFLOW_GRAPH_CONTEXT_DEFAULT_TOKEN_BUDGET=2500
IDEAFLOW_GRAPH_CONTEXT_MAX_TOKEN_BUDGET=8000
