# Production .env for IdeaFlow. Copy to /home/ideaflow/IdeaFlow/.env on the
# server and fill in. Never commit the real file.

# Generate with:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Never true in production.
DJANGO_DEBUG=false

DJANGO_ALLOWED_HOSTS=bitesoftheweek.com,www.bitesoftheweek.com

# Django 4+ needs the scheme; these are the https origins forms/login post to.
DJANGO_CSRF_TRUSTED_ORIGINS=https://bitesoftheweek.com,https://www.bitesoftheweek.com

# Local Postgres created in the runbook. URL-encode any special chars in the password.
DATABASE_URL=postgres://ideaflow:CHANGE_ME@localhost:5432/ideaflow

# Google OAuth client for the PRODUCTION domain (see runbook step 9).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: enable the agent HTTP API. Empty disables it.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IDEAFLOW_API_TOKEN=

# Leave 0 until you're sure HTTPS is solid; then 31536000 (1 year) turns on HSTS.
DJANGO_HSTS_SECONDS=0
