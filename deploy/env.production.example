# Production .env for IdeaFlow. Copy to /home/ideaflow/IdeaFlow/.env on the
# server and fill in. Never commit the real file.

# Generate with:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Never true in production.
DJANGO_DEBUG=false

DJANGO_ALLOWED_HOSTS=ideaflow.bitesoftheweek.com

# Django 4+ needs the scheme; this is the https origin forms/login post to.
DJANGO_CSRF_TRUSTED_ORIGINS=https://ideaflow.bitesoftheweek.com

# Local Postgres created in the runbook. URL-encode any special chars in the password.
DATABASE_URL=postgres://ideaflow:CHANGE_ME@localhost:5432/ideaflow

# Google OAuth client for the PRODUCTION domain (see runbook step 11).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Enable the agent HTTP API (empty disables it). REQUIRED if agents on other
# machines will read ideas / report effort / manage feeds via the API. Give each
# remote agent this same token as its own IDEAFLOW_API_TOKEN.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IDEAFLOW_API_TOKEN=

# Measurement-first rollout flags. Enable independently only after the matching
# implementation phase and canary have passed. Raw payload capture requires an
# approved retention/redaction policy.
IDEAFLOW_EXECUTION_INSTRUMENTATION=false
IDEAFLOW_EXECUTION_GATEWAY=false
IDEAFLOW_EXECUTION_PROJECTIONS=false
IDEAFLOW_EXECUTION_FEEDBACK=false
IDEAFLOW_EXECUTION_EXPERIMENTS=false
IDEAFLOW_EXECUTION_CAPTURE_PAYLOADS=false
IDEAFLOW_EXECUTION_PAYLOAD_RETENTION_DAYS=30

# Phase 1 podcast worker token (separate from IDEAFLOW_API_TOKEN — the Mac
# mini render worker gets only this narrow credential, not general agent
# access). Empty disables the /api/audio-jobs/ endpoints entirely.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IDEAFLOW_PODCAST_WORKER_TOKEN=

# Optional weekly-summary model override (defaults to claude-opus-4-8).
IDEAFLOW_MODEL_WEEKLY_SUMMARY=claude-opus-4-8

# Separate-origin, read-only Gephi Lite explorer.
IDEAFLOW_GRAPH_LAB_ENABLED=false
IDEAFLOW_GRAPH_LAB_ORIGIN=https://graph-lab.bitesoftheweek.com
IDEAFLOW_GRAPH_CAPABILITY_TTL_SECONDS=600
IDEAFLOW_GRAPH_CAPABILITY_MAX_REQUESTS=10
IDEAFLOW_GRAPH_EXPORT_MAX_NODES=2000
IDEAFLOW_GRAPH_EXPORT_MAX_EDGES=10000
IDEAFLOW_GRAPH_EXPORT_MAX_BYTES=20971520
IDEAFLOW_GRAPH_CONTEXT_DEFAULT_TOKEN_BUDGET=2500
IDEAFLOW_GRAPH_CONTEXT_MAX_TOKEN_BUDGET=8000

# Semantic relationship worker. Uses OpenAI-compatible embeddings and chat
# completion endpoints. The default embedding is 1536 dimensions.
IDEAFLOW_SEMANTIC_API_KEY=
IDEAFLOW_SEMANTIC_API_BASE=https://api.openai.com/v1
IDEAFLOW_SEMANTIC_EMBEDDING_MODEL=text-embedding-3-small
IDEAFLOW_SEMANTIC_CLASSIFIER_MODEL=gpt-4.1-mini
IDEAFLOW_SEMANTIC_CANDIDATES=12
IDEAFLOW_SEMANTIC_MIN_SIMILARITY=0.35

# Mixed-provider council review of pending relationship suggestions. Both CLIs
# must be installed and authenticated for the service user.
IDEAFLOW_CLAUDE_BIN=claude
IDEAFLOW_CODEX_BIN=codex
IDEAFLOW_RELATIONSHIP_CLAUDE_MODEL=
IDEAFLOW_RELATIONSHIP_CODEX_MODEL=

# Leave 0 until you're sure HTTPS is solid; then 31536000 (1 year) turns on HSTS.
DJANGO_HSTS_SECONDS=0
